{:log-level #or [#env PSEUDOVISION_LOG_LEVEL :info]

 ;; Application-wide timezone (IANA id, e.g. "America/New_York"). Read directly
 ;; from the standard TZ environment variable by pseudovision.util.time
 ;; (defaults to "UTC"). Used everywhere a wall-clock zone is needed but none is
 ;; supplied explicitly: playout scheduling, EPG/XMLTV output, DailySlot
 ;; ingestion of naive datetimes, and on-screen clocks.

 :server {:port #or [#env PSEUDOVISION_HTTP_PORT 8080]}

 :database {:jdbc-url  #or [#env PSEUDOVISION_DB_URL
                            "jdbc:postgresql://localhost:5432/pseudovision"]
            :username  #or [#env PSEUDOVISION_DB_USER "pseudovision"]
            :password  #or [#env PSEUDOVISION_DB_PASS "pseudovision"]}

 ;; Path to the ffmpeg/ffprobe binaries used for media metadata extraction.
 :ffmpeg {:ffmpeg-path  #or [#env FFMPEG_PATH  "/usr/bin/ffmpeg"]
          :ffprobe-path #or [#env FFPROBE_PATH "/usr/bin/ffprobe"]}

 ;; Local filesystem scanner settings.
 :media {:scan-concurrency   4
         ;; How long to wait for ffprobe to return per file (ms).
         :probe-timeout-ms   30000
         ;; File extensions recognised as video.
         :video-extensions   [".mkv" ".mp4" ".avi" ".m4v" ".mov" ".ts" ".wmv"]
         ;; File extensions recognised as audio.
         :audio-extensions   [".mp3" ".flac" ".ogg" ".m4a" ".aac" ".wav"]
         ;; File extensions recognised as images.
         :image-extensions   [".jpg" ".jpeg" ".png" ".webp" ".gif" ".bmp"]}

  ;; Playout builder settings.
  :scheduling {:lookahead-hours 72
               ;; How often (minutes) the background rebuild job runs.
               :rebuild-interval-minutes 60}

  ;; Daily-slots packer policy. The fitter decides what happens when
  ;; `select-fitting-items` cannot find a runtime-fitting item for a
  ;; `random:<category>` slot, even after expanding the tolerance window:
  ;;
  ;;   :fail         — slot returns empty; the per-slot error surfaces in
  ;;                   the daily-slots response. Use this in dev/staging to
  ;;                   catch packer bugs at quarterly regen time.
  ;;   :warn-and-fill — slot is filled with the closest-runtime item anyway,
  ;;                   but a WARN log names the bad pick. This is the
  ;;                   default: production reliability (something on-screen)
  ;;                   wins over visible-error density.
  ;;   :off          — closest-of-N from the entire pool, no log. Not
  ;;                   recommended; exists as a quick-revert option.
  ;;
  ;; See `pseudovision.http.api.daily-slots/*fitter-strictness*` for full
  ;; semantics and `fit-fallback-window-multiplier` for the expansion bound.
  :daily-slots {:fitter-strictness :warn-and-fill}

  ;; Live streaming paths.  streams-dir is where served HLS segments live;
  ;; scratch-dir is where per-encoder temporary files are written before
  ;; ingest.  In a sharded deployment streams-dir may be a shared PVC
  ;; (so any pod can serve any channel's segments) while scratch-dir stays
  ;; local emptyDir (fast ephemeral I/O for the active encoders on this pod).
  :streaming {:streams-dir #or [#env PSEUDOVISION_STREAMS_DIR "/tmp/pseudovision/streams"]
              :scratch-dir #or [#env PSEUDOVISION_SCRATCH_DIR "/tmp/pseudovision/scratch"]}

  ;; Grout filler source (optional).  When GROUT_URL is set, filler presets that
  ;; carry `grout_tags` draw their clips from Grout (queried by channel + tags +
  ;; gap duration at playout-build time) instead of a local collection.  Grout
  ;; shares `media-dir` with Pseudovision, so ingested clips stream directly off
  ;; the mount.  Leave GROUT_URL unset to disable Grout entirely.
  :grout {:base-url   #env GROUT_URL
          :media-dir  #or [#env GROUT_MEDIA_DIR "/data/media/grout"]
          :timeout-ms 5000}}
